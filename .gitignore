.ollama/
.venv/
.hf_cache/
lib/
bin/
__pycache__/
.vscode/
ollama_*.log
*.out
# local secrets and per-user settings
.env
.claude/settings.local.json
# duplicate of the unzipped dataset/ADR_DataSet/
dataset/ADR_DataSet.zip
# quarantined output from a run where the LLM tunnel died
results/*.bad.jsonl
# external benchmark clones (fetch with: git clone --depth 1 https://github.com/practikpharma/PGxCorpus ;
# git clone --depth 1 https://github.com/KarlKeat/PGxQA); only derived files are tracked
dataset/PGxCorpus/*
!dataset/PGxCorpus/.gitkeep
dataset/PGxQA/*
!dataset/PGxQA/pgxqa_eval.jsonl
# masked KB copies are regenerated by make_masked_recovery.py; only the task files are tracked
dataset/ADR_DataSet_masked/*.tsv
